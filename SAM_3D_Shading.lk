// ── PARÁMETROS DEL ARRAY ─────────────────────────────────
rows = 11;
cols = -114;

irradiance_ref = 1000.0;   // Irradiancia de referencia (W/m²) para heatmaps de irradiancia

x0 = -9.7;
y0 = -15.20;
z0 = 0.0;

panel_length = 1.0;   // largo del panel (m)  → dirección filas (rows)
panel_width  = 1.0;   // ancho del panel (m)  → dirección columnas (cols)

spacing_x = panel_length;   // separación entre filas   (>= panel_length)
spacing_y = panel_width;    // separación entre columnas (>= panel_width)

azimut     = 225;
inclinacion = 90;

timestep_min = 60;

// ── RUTAS ────────────────────────────────────────────────
export_dir     = cwd();
results_dir    = export_dir + '/Results';
obstacles_file = '/tmp/sam_obstacles.s3d';   // sin espacios en el path → save_scene/load_scene funcionan
py_script      = export_dir + '/shade_postprocess.py';
py_exec        = export_dir + '/.venv/bin/python3';

// ── CONVERSIÓN A SAM ─────────────────────────────────────
PI = 3.14159265;

ori_rad = (azimut + 180) * PI / 180;
inc_rad = inclinacion * PI / 180;

dir_hx =  cos(ori_rad);
dir_hy = -sin(ori_rad);

dir_sx = sin(ori_rad) * cos(inc_rad);
dir_sy = cos(ori_rad) * cos(inc_rad);
dir_sz = sin(inc_rad);

nx = -sin(ori_rad) * sin(inc_rad);
ny = -cos(ori_rad) * sin(inc_rad);
nz =  cos(inc_rad);

sam_tilt = acos(nz) * 180 / PI;
sam_az   = atan2(nx, ny) * 180 / PI;
if (sam_az < 0) { sam_az = sam_az + 360; }

// ── SIGNO Y VALOR ABSOLUTO DE ROWS/COLS ─────────────────
// Valores negativos invierten la dirección de expansión del array.
// Ej: cols = -114 → la instalación crece en sentido opuesto al eje horizontal.
abs_rows = rows; if (rows < 0) { abs_rows = -rows; }
abs_cols = cols; if (cols < 0) { abs_cols = -cols; }
sign_rows = 1;   if (rows < 0) { sign_rows = -1; }
sign_cols = 1;   if (cols < 0) { sign_cols = -1; }

// ── CÁLCULO DE BATCHES ───────────────────────────────────
max_subarrays = 4;
max_strings   = 8;
max_surfaces  = max_subarrays * max_strings;   // 32 por batch

n_total   = abs_rows * abs_cols;
n_batches = to_int((n_total + max_surfaces - 1) / max_surfaces);

// ── VALIDACIONES ─────────────────────────────────────────
if (spacing_x < panel_length) { outln('AVISO: spacing_x < panel_length → paneles solapados en filas.'); }
if (spacing_y < panel_width)  { outln('AVISO: spacing_y < panel_width  → paneles solapados en columnas.'); }

loc = location();
if (loc.lat == 0 && loc.lon == 0)
{
    outln('ERROR: Ubicación no configurada. Ve a la pestaña Location.');
    exit;
}

outln('Array: ' + rows + 'x' + cols + ' = ' + n_total + ' paneles   |   ' + n_batches + ' batch(es)');
outln('Ubicación: lat=' + loc.lat + '  lon=' + loc.lon + '  tz=' + loc.tz);
outln('SAM Tilt=' + sam_tilt + '  SAM Az=' + sam_az);
outln('');

// ── GUARDAR OBSTÁCULOS ───────────────────────────────────
// El archivo de obstáculos debe contener SOLO obstáculos (sin superficies activas)
// para que load_scene() en el loop no requiera ningún delete() posterior.
// Eso solo es posible cuando la escena está limpia al ejecutar el script.
//
// PROTOCOLO si se modifican obstáculos:
//   1. Pulsar "New" en SAM  (limpia la escena)
//   2. Añadir los obstáculos en su nueva posición
//   3. Ejecutar este script
//
// Ejecuciones normales (sin cambiar obstáculos): ejecutar directamente.

// Crear Results/ si no existe
sh_mkdir = '/tmp/sam_mkdir.sh';
fh_mkdir = open(sh_mkdir, 'w');
write_line(fh_mkdir, '#!/bin/bash');
write_line(fh_mkdir, 'mkdir -p "' + results_dir + '"');
close(fh_mkdir);
system('bash ' + sh_mkdir);

existing = objects();
n_active = 0;
for (i = 0; i < #existing; i++)
{
    props = property(existing[i]);
    keys  = @props;
    for (j = 0; j < #keys; j++)
    {
        if (keys[j] == 'Subarray') { n_active = n_active + 1; break; }
    }
}

if (n_active == 0)
{
    save_scene(obstacles_file);
    outln('Obstáculos guardados: ' + obstacles_file);
}
else
{
    fh_test = open(obstacles_file, 'r');
    if (fh_test >= 0)
    {
        close(fh_test);
        outln('Usando obstáculos guardados: ' + obstacles_file);
        outln('(Para actualizar obstáculos: "New" → añadir obstáculos → ejecutar.)');
    }
    else
    {
        outln('ERROR: no existe archivo de obstáculos.');
        outln('Pulsa "New" en SAM, añade los obstáculos y ejecuta el script.');
        exit;
    }
}
outln('');

// ── LOOP DE BATCHES ───────────────────────────────────────
// clear_scene() es siempre seguro, incluso con superficies que hayan
// pasado por direct_shade(). No se usa delete() en ningún momento.
batch_files_arg = '';

for (b = 0; b < n_batches; b++)
{
    batch_start = b * max_surfaces;
    batch_end   = batch_start + max_surfaces;
    if (batch_end > n_total) { batch_end = n_total; }
    batch_count = batch_end - batch_start;

    outln('=== Batch ' + (b+1) + '/' + n_batches + '  paneles ' + batch_start + '..' + (batch_end-1) + ' (' + batch_count + ' unidades) ===');

    // Resetear escena y restaurar obstáculos (el archivo solo contiene obstáculos)
    clear_scene();
    load_scene(obstacles_file);
    uiyield();
    millisleep(500);

    // ── CREAR SUPERFICIES ACTIVAS ─────────────────────────
    for (local_idx = 0; local_idx < batch_count; local_idx++)
    {
        panel_idx  = batch_start + local_idx;
        global_row = to_int(panel_idx / abs_cols);
        global_col = panel_idx - to_int(panel_idx / abs_cols) * abs_cols;

        local_sub = to_int(local_idx / max_strings);
        local_str = local_idx - local_sub * max_strings;

        px = x0 + global_col * spacing_y * sign_cols * dir_hx + global_row * spacing_x * sign_rows * dir_sx;
        py = y0 + global_col * spacing_y * sign_cols * dir_hy + global_row * spacing_x * sign_rows * dir_sy;
        pz = z0 +                                                global_row * spacing_x * sign_rows * dir_sz;

        p = {};
        p.Name     = 'AS_r' + global_row + '_c' + global_col;
        p.Subarray = local_sub;
        p.String   = local_str;
        p.Group    = 'SA' + (global_row + 1) + '_ST' + (global_col + 1);
        p.X        = px;
        p.Y        = py;
        p.Z        = pz;
        p.Width    = panel_width;
        p.Length   = panel_length;
        p.Azimuth  = sam_az;
        p.Tilt     = sam_tilt;
        p.Shape    = 'rectangle';

        obj = create('Active surface');
        property(obj, p);
    }
    uiyield();

    // ── ANÁLISIS DE SOMBRA ────────────────────────────────
    outln('  Calculando direct_shade()...');
    millisleep(500);

    ts = direct_shade(timestep_min);

    if (ts == null)
    {
        outln('ERROR: direct_shade() falló en batch ' + (b+1) + '. Abortando.');
        exit;
    }

    groups   = @ts;
    n_groups = #groups;
    n_points = #ts{groups[0]};
    outln('  Grupos: ' + n_groups + '   Puntos: ' + n_points);

    // ── EXPORTAR CSV ─────────────────────────────────────
    batch_file = results_dir + '/shade_batch' + b + '_az' + azimut + '_inc' + inclinacion + '.csv';
    fh = open(batch_file, 'w');
    if (fh < 0) { outln('ERROR: no se pudo abrir ' + batch_file); exit; }

    line = 'Hora';
    for (k = 0; k < n_groups; k++) { line = line + ',' + groups[k]; }
    write_line(fh, line);

    for (h = 0; h < n_points; h++)
    {
        line = '' + (h + 1);
        for (k = 0; k < n_groups; k++) { line = line + ',' + ts{groups[k]}[h]; }
        write_line(fh, line);
    }
    close(fh);
    outln('  CSV: ' + batch_file);

    batch_files_arg = batch_files_arg + ' "' + batch_file + '"';

    outln('');
}

// ── POST-PROCESO PYTHON ───────────────────────────────────
outln('Todos los batches completados. Fusionando con Python...');

py_cmd = '"' + py_exec + '" "' + py_script + '" --batches' + batch_files_arg + ' --out "' + results_dir + '" --width ' + panel_width + ' --length ' + panel_length + ' --cols ' + abs_cols + ' --irradiance ' + irradiance_ref;

sh_file = '/tmp/sam_shade_post.sh';
fh = open(sh_file, 'w');
if (fh >= 0)
{
    write_line(fh, '#!/bin/bash');
    write_line(fh, 'export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:$PATH"');
    write_line(fh, 'mkdir -p "' + results_dir + '"');
    write_line(fh, py_cmd);
    close(fh);

    ret = system('bash ' + sh_file);
    if (ret == 0) { outln('Post-proceso completado. Archivos en: ' + results_dir); }
    else          { outln('AVISO: Python retornó código ' + ret + '. Ejecuta manualmente:'); outln('  ' + py_cmd); }
}
else
{
    outln('No se pudo escribir script temporal. Ejecuta manualmente:');
    outln('  ' + py_cmd);
}

outln('');
outln('Completado: ' + n_total + ' paneles (' + rows + 'x' + cols + ') en ' + n_batches + ' batches.');

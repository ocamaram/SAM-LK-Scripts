// ── PARÁMETROS ──────────────────────────────────────────
rows = 4;
cols = 8;

x0 = 0.0;
y0 = 0.0;
z0 = 0.0;

panel_width  = 1.0;   // ancho del panel (m)  → dirección columnas (strings)
panel_length = 2.0;   // largo del panel (m)  → dirección filas (subarrays)

// Separación entre orígenes de paneles. Por defecto = dimensión del panel (sin hueco).
// Aumenta para añadir espacio entre paneles.
spacing_x = panel_length;   // separación entre filas   (debe ser >= panel_length)
spacing_y = panel_width;    // separación entre columnas (debe ser >= panel_width)

// azimut: orientacion solar de la superficie (0=N, 90=E, 180=S, 270=O)
// inclinacion: 0=horizontal (suelo), 90=vertical (fachada)
azimut     = 180;
inclinacion = 30;

// timestep en minutos para el análisis de series temporales (60 → 8760 puntos/año)
timestep_min = 60;

// Directorio del script = directorio de exportación y ubicación del script Python
export_dir = cwd();
py_script  = export_dir + '/shade_postprocess.py';
outln('Directorio de trabajo: ' + export_dir);

// ── CONVERSIÓN A SAM ─────────────────────────────────────
PI = 3.14159265;

ori_rad = (azimut + 180) * PI / 180;
inc_rad = inclinacion * PI / 180;

dir_hx =  cos(ori_rad);
dir_hy = -sin(ori_rad);

dir_sx = sin(ori_rad) * cos(inc_rad);
dir_sy = cos(ori_rad) * cos(inc_rad);
dir_sz = sin(inc_rad);

nx = -sin(ori_rad) * sin(inc_rad);
ny = -cos(ori_rad) * sin(inc_rad);
nz =  cos(inc_rad);

sam_tilt = acos(nz) * 180 / PI;
sam_az   = atan2(nx, ny) * 180 / PI;
if (sam_az < 0) { sam_az = sam_az + 360; }

// ── LÍMITES ──────────────────────────────────────────────
max_subarrays = 4;
max_strings   = 8;
max_surfaces  = max_subarrays * max_strings;

// ── VALIDACIÓN ───────────────────────────────────────────
if (spacing_x < panel_length) { outln('AVISO: spacing_x (' + spacing_x + ') < panel_length (' + panel_length + ') → los paneles se solaparán en filas.'); }
if (spacing_y < panel_width)  { outln('AVISO: spacing_y (' + spacing_y + ') < panel_width ('  + panel_width  + ') → los paneles se solaparán en columnas.'); }

n_total = rows * cols;

if (n_total > max_surfaces)
{
    outln('ERROR: ' + n_total + ' superficies solicitadas, máximo permitido = ' + max_surfaces);
    outln('Reduce rows (' + rows + ') x cols (' + cols + ') a un máximo de ' + max_surfaces);
}
else
{
    // Volver siempre a la pestaña Scene antes de modificar objetos
    // (si la ejecución anterior terminó en Analyze, borrar objetos desde esa pestaña crashea SAM)
    switch_to(1);
    uiyield();
    millisleep(500);

    // ── ELIMINAR SOLO SUPERFICIES ACTIVAS PREVIAS ────────
    // Los obstáculos (Tree, Box, etc.) no tienen la propiedad 'Subarray' → se conservan
    existing = objects();
    for (i = 0; i < #existing; i++)
    {
        props = property(existing[i]);
        keys  = @props;
        for (j = 0; j < #keys; j++)
        {
            if (keys[j] == 'Subarray')
            {
                delete(existing[i]);
                break;
            }
        }
    }
    uiyield();
    millisleep(300);

    // ── CREAR SUPERFICIES ACTIVAS ─────────────────────────
    idx = 0;

    for (r = 0; r < rows; r++)
    {
        for (c = 0; c < cols; c++)
        {
            subarray = to_int(idx / max_strings) + 1;
            string   = idx - to_int(idx / max_strings) * max_strings + 1;

            px = x0 + c * spacing_y * dir_hx + r * spacing_x * dir_sx;
            py = y0 + c * spacing_y * dir_hy + r * spacing_x * dir_sy;
            pz = z0 +                          r * spacing_x * dir_sz;

            p = {};
            p.Name     = 'AS_az' + azimut + '_inc' + inclinacion + '_sub' + subarray + '_str' + string;
            p.Subarray = subarray - 1;
            p.String   = string - 1;
            p.Group    = 'SA' + subarray + '_ST' + string;
            p.X        = px;
            p.Y        = py;
            p.Z        = pz;
            p.Width    = panel_width;
            p.Length   = panel_length;
            p.Azimuth  = sam_az;
            p.Tilt     = sam_tilt;
            p.Shape    = 'rectangle';

            obj = create('Active surface');
            property(obj, p);

            outln('Creada: ' + p.Name + '  X=' + px + '  Y=' + py + '  Z=' + pz);

            idx = idx + 1;
        }
    }
    uiyield();

    outln('--- Azimut=' + azimut + '  Inclinacion=' + inclinacion);
    outln('--- SAM Tilt=' + sam_tilt + '  SAM Az=' + sam_az);
    outln('--- Total: ' + n_total + ' de ' + max_surfaces);
    outln('');

    // ── VALIDAR UBICACIÓN ────────────────────────────────
    loc = location();
    if (loc.lat == 0 && loc.lon == 0)
    {
        outln('ERROR: Ubicación no configurada.');
        outln('Ve a la pestaña Location y configura latitud, longitud y zona horaria antes de ejecutar.');
        exit;
    }
    outln('Ubicación: lat=' + loc.lat + '  lon=' + loc.lon + '  tz=' + loc.tz);

    // ── ANÁLISIS TIME SERIES (sombra directa/beam) ────────
    // Un único switch_to(2) con sleep generoso cubre tanto primera como sucesivas ejecuciones
    outln('Calculando series temporales de sombra directa...');
    switch_to(2);
    uiyield();
    millisleep(2000);

    ts = direct_shade(timestep_min);

    if (ts == null)
    {
        outln('ERROR: direct_shade() falló. Verifica que la ubicación esté configurada (pestaña Location).');
    }
    else
    {
        groups   = @ts;
        n_groups = #groups;
        n_points = #ts{groups[0]};
        outln('Grupos: ' + n_groups + '   Puntos temporales: ' + n_points);

        // construir array 2D para CSV:  fila 0 = cabecera, filas 1..n_points = datos
        csv_ts[0][0] = 'Hora';
        for (k = 0; k < n_groups; k++)
        {
            csv_ts[0][k+1] = groups[k];
        }

        for (h = 0; h < n_points; h++)
        {
            csv_ts[h+1][0] = h + 1;
            for (k = 0; k < n_groups; k++)
            {
                csv_ts[h+1][k+1] = ts{groups[k]}[h];
            }
        }

        diff_file = '';
        ts_file   = export_dir + '/shade_timeseries_az' + azimut + '_inc' + inclinacion + '.csv';
        ok = csvwrite(ts_file, csv_ts);
        if (ok) { outln('Serie temporal exportada: ' + ts_file); }
        else    { outln('ERROR: no se pudo escribir ' + ts_file); }

        // ── POST-PROCESO PYTHON ───────────────────────────
        outln('');
        py_cmd = 'python3 "' + py_script + '" --ts "' + ts_file + '" --out "' + export_dir + '" --width ' + panel_width + ' --length ' + panel_length;

        // Escribir comando en /tmp (sin espacios) y ejecutarlo con system()
        sh_file = '/tmp/sam_shade_post.sh';
        fh = open(sh_file, 'w');
        if (fh >= 0)
        {
            write_line(fh, '#!/bin/bash');
            write_line(fh, 'export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:$PATH"');
            write_line(fh, py_cmd);
            close(fh);

            outln('Ejecutando post-proceso Python...');
            ret = system('bash ' + sh_file);
            if (ret == 0)
            {
                outln('Post-proceso completado. Archivos generados en: ' + export_dir);
            }
            else
            {
                outln('AVISO: python3 retornó código ' + ret + '. Ejecuta manualmente:');
                outln('  ' + py_cmd);
            }
        }
        else
        {
            outln('No se pudo escribir script temporal. Ejecuta manualmente:');
            outln('  ' + py_cmd);
        }

        outln('');
        outln('Completado. Archivos guardados en: ' + export_dir);
    }
}
